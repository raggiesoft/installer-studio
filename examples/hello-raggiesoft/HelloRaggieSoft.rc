// ================================================================================
// FILE: examples/hello-raggiesoft/HelloRaggieSoft.rc
// PROJECT: RaggieSoft Setup Wizard ("Install Without Limits")
// LICENSE: MIT License (Copyright (c) 2026 Michael P. Ragsdale / RaggieSoft)
//
// PLAIN-ENGLISH OVERVIEW FOR 100-LEVEL READERS:
//   Embeds Common Controls v6 + `VERSIONINFO` (`1.0.0.0`) into `HelloRaggieSoft.exe`
//   so `rsswbuild.exe` can harvest PE file version and language metadata automatically!
// ================================================================================

#include <winresrc.h>

1 24
BEGIN
    "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>\r\n"
    "<assembly xmlns=""urn:schemas-microsoft-com:asm.v1"" manifestVersion=""1.0"">\r\n"
    "  <dependency>\r\n"
    "    <dependentAssembly>\r\n"
    "      <assemblyIdentity type=""win32"" name=""Microsoft.Windows.Common-Controls"" version=""6.0.0.0"" processorArchitecture=""*"" publicKeyToken=""6595b64144ccf1df"" language=""*""/>\r\n"
    "    </dependentAssembly>\r\n"
    "  </dependency>\r\n"
    "</assembly>\r\n"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RaggieSoft"
            VALUE "FileDescription",  "Hello RaggieSoft Sample Application"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "HelloRaggieSoft"
            VALUE "LegalCopyright",   "Copyright (c) 2026 RaggieSoft (MIT License)"
            VALUE "OriginalFilename", "HelloRaggieSoft.exe"
            VALUE "ProductName",      "Hello RaggieSoft"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
