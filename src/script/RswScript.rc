//
// PLAIN-ENGLISH OVERVIEW FOR 100-LEVEL READERS:
//   Embeds RaggieSoft version metadata (`VS_VERSION_INFO`) into `raggiescript.exe`,
//   our zero-dependency native Win32 C++20 RaggieScript (`.rssc`) compiler, linter,
//   `RSWBC1` bytecode disassembler, runtime interpreter, and standalone micro-app
//   executable packager (`x64` & `ARM64`).
// ================================================================================

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,0,0
 PRODUCTVERSION 0,6,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RaggieSoft"
            VALUE "FileDescription",  "RaggieScript Compiler, VM & Micro-App Packager (raggiescript.exe)"
            VALUE "FileVersion",      "0.6.0.0"
            VALUE "InternalName",     "raggiescript"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Michael P. Ragsdale / RaggieSoft (MIT License)"
            VALUE "OriginalFilename", "raggiescript.exe"
            VALUE "ProductName",      "RaggieSoft Studio - RaggieScript Engine"
            VALUE "ProductVersion",   "0.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
