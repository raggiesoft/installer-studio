{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RaggieSoft Project Manifest",
  "scopeName": "source.raggiesoft-manifest",
  "patterns": [
    {
      "name": "comment.line.semicolon.rsip",
      "match": "(?:^\\s*[;#]|\\s+;).*$"
    },
    {
      "name": "meta.include.rsip",
      "match": "^\\s*(@include)\\s+(\".*\")",
      "captures": {
        "1": {
          "name": "keyword.control.import.rsip"
        },
        "2": {
          "name": "string.quoted.double.rsip"
        }
      }
    },
    {
      "name": "entity.name.section.rsip",
      "match": "^\\s*\\[[A-Za-z0-9_.-]+\\]"
    },
    {
      "match": "^\\s*([A-Za-z0-9_.-]+)\\s*(=)\\s*(.*)$",
      "captures": {
        "1": {
          "name": "variable.other.property.rsip"
        },
        "2": {
          "name": "keyword.operator.assignment.rsip"
        },
        "3": {
          "patterns": [
            {
              "name": "comment.line.inline.rsip",
              "match": "\\s+;.*$"
            },
            {
              "name": "constant.other.placeholder.rsip",
              "match": "\\$\\([A-Za-z0-9_]+\\)|\\[[A-Z0-9_]+\\]"
            },
            {
              "name": "constant.language.boolean.rsip",
              "match": "\\b(true|false|machine|user|asInvoker|highestAvailable|requireAdministrator)\\b"
            },
            {
              "name": "constant.other.guid.rsip",
              "match": "\\{[0-9A-Fa-f-]{36}\\}"
            },
            {
              "name": "constant.other.color.rsip",
              "match": "#[0-9A-Fa-f]{6}\\b"
            }
          ]
        }
      }
    }
  ]
}
