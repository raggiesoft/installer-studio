{
  "RaggieScript Deferred-UAC Package": {
    "prefix": "rssc-package",
    "body": [
      "use installer;",
      "",
      "package \"${1:My Application}\" {",
      "    id: \"${2:{A18F4E20-7C93-4D62-9B44-524147474945}}\";",
      "    version: v\"${3:1.0.0}\";",
      "    publisher: \"${4:RaggieSoft}\";",
      "    scope: Scope.Machine;",
      "    uac: Uac.Deferred;",
      "    style: WizardStyle.FluentMica;",
      "}",
      "",
      "param createDesktopIcon: bool = true;",
      "",
      "wizard {",
      "    step Welcome {",
      "        if (!ui.confirm(\"Ready to Install\", \"Click Continue to install.\", shield: true)) {",
      "            wizard.cancel();",
      "        }",
      "    }",
      "}",
      "",
      "install {",
      "    ui.progress(25, \"Installing files...\");",
      "    fs.mkdir(installDir);",
      "    $0",
      "    ui.progress(100, \"Complete.\");",
      "}"
    ],
    "description": "Create a full RaggieScript installer with commit-time deferred UAC elevation"
  },
  "RaggieScript Task Dialog": {
    "prefix": "rssc-taskdialog",
    "body": [
      "let choice = 100;",
      "ui.taskDialog(",
      "    title: \"${1:Setup}\",",
      "    heading: \"${2:Choose Installation Option}\",",
      "    body: \"${3:Select how you want to proceed.}\",",
      "    buttons: [",
      "        { id: 100, text: \"&Continue\", subtitle: \"${4:Recommended action}\", shield: ${5:false} },",
      "        { id: 101, text: \"Cancel\",    subtitle: \"Exit without making changes\" }",
      "    ],",
      "    choice: ref choice",
      ");"
    ],
    "description": "Insert a Windows 11 Command-Link TaskDialog"
  },
  "RaggieScript Direct MSI SQL Query": {
    "prefix": "rssc-msisql",
    "body": [
      "msi.execSql(${1:msiPath}, [",
      "    \"${2:UPDATE `Property` SET `Value`='1' WHERE `Property`='ALLUSERS'}\"",
      "]);",
      "let rows = msi.query(${1:msiPath}, \"${3:SELECT `Property`, `Value` FROM `Property`}\");"
    ],
    "description": "Execute direct relational SQL statements on an .MSI or .MSM database"
  },
  "RaggieScript Native DLL FFI Call": {
    "prefix": "rssc-ffi",
    "body": [
      "let result = ffi.call(\"${1:kernel32.dll}\", \"${2:GetCurrentProcessId}\", \"${3:uint}\", [$4]);"
    ],
    "description": "Invoke a 64-bit native Windows DLL export via ffi.call"
  }
}
