; ==============================================================================
; FILE: projects/books/heather/heather.rsip
; BOOK EDITION: The Story of Heather Lindstrom (Ocean View Archives)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = The Story of Heather Lindstrom
Tagline               = Ocean View Archives Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
UpgradeCode           = {6A317924-8050-5C63-B9BD-2AE7C0ACEC2F}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-heather-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Books\heather

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = Ocean View Archives
AccentPrimaryHex      = #14B8A6
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\heather.jpg
InstallButtonText     = &Install Book
OfferLaunchOnFinish   = false

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\heather

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\heather.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\heather.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Payload.Scenes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\heather
TargetSubdir          = assets\raggiesoft-books\images\scenes\heather

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = heather
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\heather
Name                  = Install Path
Value                 = [INSTALLDIR]
