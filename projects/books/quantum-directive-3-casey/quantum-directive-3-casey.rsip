; ==============================================================================
; FILE: projects/books/quantum-directive-3-casey/quantum-directive-3-casey.rsip
; BOOK EDITION: The Quantum Directive - The Caretakers (Ocean View Archives)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = The Quantum Directive - The Caretakers
Tagline               = Ocean View Archives Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
UpgradeCode           = {BCAAB940-A5E6-5C49-9EE1-947E9D8D5B00}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-quantum-directive-3-casey-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Books\quantum-directive-3-casey

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = Ocean View Archives
AccentPrimaryHex      = #14B8A6
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\quantum-directive-3-casey.jpg
InstallButtonText     = &Install Book
OfferLaunchOnFinish   = false

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\quantum-directive-3-casey

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\quantum-directive-3-casey.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\quantum-directive-3-casey.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Payload.CrossPlate1]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\apr_2005_prospectors_keep_great_hall_bloodline_reveal.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Payload.CrossPlate2]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\aug_1995_npu_quad_cassandra_steve_ballantine.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Payload.CrossPlate3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\christmas_eve_puppy_pile.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Payload.CrossPlate4]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\feb_2014_keswick_auditorium_cassandra_ceo_handover.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Payload.CrossPlate5]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\feb_2014_zero_proof_pavilion_cassandra_jessica_pack.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Payload.CrossPlate6]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\jan_2014_bellevue_bullpen_coding_and_lpn_check.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Payload.CrossPlate7]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\jun_2014_senate_judiciary_hearing_mar_protocol.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Payload.CrossPlate8]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\mar_2005_evergreen_marine_ferry_elliott_bay.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Payload.CrossPlate9]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\casey\nov_2004_thanksgiving_twenty_one_day_bridge_bedroom.jpg
