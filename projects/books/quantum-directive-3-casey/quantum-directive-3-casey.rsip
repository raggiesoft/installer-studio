TargetSubdir          = assets\raggiesoft-books\images\scenes\casey

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = quantum-directive-3-casey
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\quantum-directive-3-casey
Name                  = Install Path
Value                 = [INSTALLDIR]
