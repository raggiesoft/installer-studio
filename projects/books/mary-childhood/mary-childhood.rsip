; ==============================================================================
; FILE: projects/books/mary-childhood/mary-childhood.rsip
; BOOK EDITION: Mary's Childhood (Ocean View Archives)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = Mary's Childhood
Tagline               = Ocean View Archives Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
UpgradeCode           = {A9C15871-AEC9-5248-85BB-2591C1449661}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-mary-childhood-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Books\mary-childhood

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = Ocean View Archives
AccentPrimaryHex      = #14B8A6
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\mary-childhood.jpg
InstallButtonText     = &Install Book
OfferLaunchOnFinish   = false

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\mary-childhood

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\mary-childhood.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\mary-childhood.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = mary-childhood
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\mary-childhood
Name                  = Install Path
Value                 = [INSTALLDIR]
