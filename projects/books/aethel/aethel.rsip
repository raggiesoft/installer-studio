; ==============================================================================
; FILE: projects/books/aethel/aethel.rsip
; BOOK EDITION: The Silver Gauntlet of Aethel (Ocean View Archives)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = The Silver Gauntlet of Aethel
Tagline               = Ocean View Archives Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
UpgradeCode           = {B6973282-9E11-520B-87A6-5B9A7B8675F0}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-aethel-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Books\aethel

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = Ocean View Archives
AccentPrimaryHex      = #14B8A6
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\aethel.jpg
InstallButtonText     = &Install Book
OfferLaunchOnFinish   = false

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\aethel

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\aethel.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\aethel.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = aethel
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\aethel
Name                  = Install Path
Value                 = [INSTALLDIR]
