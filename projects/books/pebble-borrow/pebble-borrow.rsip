; ==============================================================================
; FILE: projects/books/pebble-borrow/pebble-borrow.rsip
; BOOK EDITION: Pebble Borrow (Ocean View Archives)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = Pebble Borrow
Tagline               = Ocean View Archives Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
UpgradeCode           = {8C09E21D-1F31-524E-9125-A7A9483F6F76}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-pebble-borrow-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Books\pebble-borrow

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = Ocean View Archives
AccentPrimaryHex      = #14B8A6
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\pebble-borrow.jpg
InstallButtonText     = &Install Book
OfferLaunchOnFinish   = false

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\pebble-borrow

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\pebble-borrow.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\pebble-borrow.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = pebble-borrow
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\pebble-borrow
Name                  = Install Path
Value                 = [INSTALLDIR]
