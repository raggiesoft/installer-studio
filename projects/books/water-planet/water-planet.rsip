; ==============================================================================
; FILE: projects/books/water-planet/water-planet.rsip
; BOOK EDITION: Water Planet (Ocean View Archives)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = Water Planet
Tagline               = Ocean View Archives Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
UpgradeCode           = {2CA89576-FF3A-5614-865F-F3BA85F53652}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-water-planet-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Books\water-planet

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = Ocean View Archives
AccentPrimaryHex      = #14B8A6
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\water-planet.jpg
InstallButtonText     = &Install Book
OfferLaunchOnFinish   = false

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\water-planet

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\water-planet.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\water-planet.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = water-planet
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\water-planet
Name                  = Install Path
Value                 = [INSTALLDIR]
