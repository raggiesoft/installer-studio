; ==============================================================================
; FILE: projects/books/nichole/nichole.rsip
; BOOK EDITION: Nichole (Ocean View Archives)
; PROJECT TYPE: Host-Aware Add-On Installer (PackageKind = addon -> Book Reader)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
SchemaVersion         = 0.9
Name                  = Nichole
Tagline               = Ocean View Archives Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
PackageKind           = addon
UpgradeCode           = {76694727-5BF9-5CEF-A0D3-DAB851E8CB43}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-nichole-$(ARCH)
OutputDir             = out
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[HostApp]
Name                  = RaggieSoft Book Reader
UpgradeCode           = {71EC9272-2D8E-5089-82E3-4D296C1D7CAC}
RegistryHive          = auto
RegistryKey           = Software\RaggieSoft\Book Reader
RegistryValue         = Install Path
FallbackSubdir        = RaggieSoft\Book Reader
Executable            = BookReader.exe
ContentTargetRoot     = LocalAppData
ContentSubdir         = RaggieSoft\Books\nichole
RequireHostInstalled  = true
DownloadUrl           = https://books.raggiesoft.com
LaunchUri             = https://books.raggiesoft.com
RefreshArgs           = --refresh-library

[UI]
WizardLayout          = simple
AllowChangeFolder     = false
AuthorOrArtist        = Ocean View Archives
AccentPrimaryHex      = #117A72
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\nichole.jpg
InstallButtonText     = &Install Book
FinishLaunchCheckbox  = &Open RaggieSoft Book Reader when finished
OfferLaunchOnFinish   = true

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\nichole

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\nichole.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\nichole.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Payload.Scenes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\nichole
TargetSubdir          = assets\raggiesoft-books\images\scenes\nichole

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = nichole
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\nichole
Name                  = Install Path
Value                 = [INSTALLDIR]
