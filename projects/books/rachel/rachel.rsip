; ==============================================================================
; FILE: projects/books/rachel/rachel.rsip
; BOOK EDITION: The Rachel Narrative (Ocean View Archives)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = The Rachel Narrative
Tagline               = Ocean View Archives Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
UpgradeCode           = {50E4CC0C-B3F6-5D11-8D4B-96AEC48A8AA9}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-rachel-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Books\rachel

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = Ocean View Archives
AccentPrimaryHex      = #14B8A6
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\rachel.jpg
InstallButtonText     = &Install Book
OfferLaunchOnFinish   = false

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\rachel

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\rachel.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\rachel.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Payload.Scenes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\rachel
TargetSubdir          = assets\raggiesoft-books\images\scenes\rachel

[Payload.CrossPlate1]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\characters\diego_chavez\diego_chavez.jpg
TargetSubdir          = assets\raggiesoft-books\images\characters\diego_chavez

[Payload.CrossPlate2]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\characters\jaxson_vance\jaxson_vance.jpg
TargetSubdir          = assets\raggiesoft-books\images\characters\jaxson_vance

[Payload.CrossPlate3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\characters\preston_sinclair\preston_sinclair.jpg
TargetSubdir          = assets\raggiesoft-books\images\characters\preston_sinclair

[Payload.CrossPlate4]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\delores_spots_michael.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes

[Payload.CrossPlate5]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\financial_severance_embrace.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes

[Payload.CrossPlate6]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\jessica-taps-train-ghosts.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes

[Payload.CrossPlate7]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\katie\b001\jul_1994_vdu_summer_camp_two_sibling_pairs_computer_lab.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes\katie\b001

[Payload.CrossPlate8]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\marcus_sterling_ultimatum.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes

[Payload.CrossPlate9]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\michael_jessica_piggyback.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes

[Payload.CrossPlate10]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\sensory_meltdown_regulation.jpg
TargetSubdir          = assets\raggiesoft-books\images\scenes

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = rachel
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\rachel
Name                  = Install Path
Value                 = [INSTALLDIR]
