; ==============================================================================
; FILE: projects/books/cedar-run/cedar-run.rsip
; BOOK EDITION: Cedar Run (RaggieSoft Story Crossroads)
; PROJECT TYPE: Host-Aware Add-On Installer (PackageKind = addon -> Book Reader)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
SchemaVersion         = 0.9
Name                  = Cedar Run
Tagline               = RaggieSoft Story Crossroads Offline Illustrated Edition
WebsiteLabel          = books.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft Media
PackageKind           = addon
UpgradeCode           = {2171CD23-BD58-501A-ACC3-C0A9C9956DF1}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-book-cedar-run-$(ARCH)
OutputDir             = out
HideFromInstalledApps = true
AboutUrl              = https://books.raggiesoft.com

[HostApp]
Name                  = RaggieSoft Book Reader
UpgradeCode           = {71EC9272-2D8E-5089-82E3-4D296C1D7CAC}
RegistryHive          = auto
RegistryKey           = Software\RaggieSoft\Book Reader
RegistryValue         = Install Path
FallbackSubdir        = RaggieSoft\Book Reader
Executable            = BookReader.exe
ContentTargetRoot     = LocalAppData
ContentSubdir         = RaggieSoft\Books\cedar-run
RequireHostInstalled  = true
DownloadUrl           = https://books.raggiesoft.com
LaunchUri             = https://books.raggiesoft.com
RefreshArgs           = --refresh-library

[UI]
WizardLayout          = simple
AllowChangeFolder     = false
AuthorOrArtist        = RaggieSoft Story Crossroads
AccentPrimaryHex      = #117A72
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\BookReader\Assets\BookReader.ico
ArtworkPng            = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\cedar-run.jpg
InstallButtonText     = &Install Book
FinishLaunchCheckbox  = &Open RaggieSoft Book Reader when finished
OfferLaunchOnFinish   = true

[Payload.Chapters]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\books\cedar-run

[Payload.Themes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\css\themes
TargetSubdir          = themes

[Payload.Cover2x3]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\2x3\cedar-run.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\2x3

[Payload.CoverOg]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\covers\og\cedar-run.jpg
TargetSubdir          = assets\raggiesoft-books\images\covers\og

[Payload.Scenes]
Source                = ..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\raggiesoft-books\images\scenes\cedar-run
TargetSubdir          = assets\raggiesoft-books\images\scenes\cedar-run

[Registry.PackList]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\List
Name                  = cedar-run
Value                 = [INSTALLDIR]

[Registry.PackDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\Book Reader\Books\cedar-run
Name                  = Install Path
Value                 = [INSTALLDIR]
