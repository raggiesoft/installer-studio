; ==============================================================================
; FILE: projects/albums/fractured-prisms/1983-carnaby-street/1983-carnaby-street.rsip
; ALBUM EDITION: Carnaby Street - Fractured Prisms (Fractured Prisms)
; PROJECT TYPE: Host-Aware Add-On Installer (PackageKind = addon -> Listening Room)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
SchemaVersion         = 0.9
Name                  = Carnaby Street - Fractured Prisms
Tagline               = Fractured Prisms - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
PackageKind           = addon
UpgradeCode           = {DCAEF80A-F19A-5E98-A0AB-C25640A3075A}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-1983-carnaby-street-$(ARCH)
OutputDir             = out
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[HostApp]
Name                  = RaggieSoft The Listening Room
UpgradeCode           = {E347B8ED-1588-5A46-A23E-441676EB4EC5}
RegistryHive          = auto
RegistryKey           = Software\RaggieSoft\The Listening Room
RegistryValue         = Install Path
FallbackSubdir        = RaggieSoft\The Listening Room
Executable            = ListeningRoom.exe
ContentTargetRoot     = LocalAppData
ContentSubdir         = RaggieSoft\Music\fractured-prisms\1983-carnaby-street
RequireHostInstalled  = true
DownloadUrl           = https://music.raggiesoft.com
LaunchUri             = https://music.raggiesoft.com
RefreshArgs           = --refresh-library

[UI]
WizardLayout          = simple
AllowChangeFolder     = false
AuthorOrArtist        = Fractured Prisms
AccentPrimaryHex      = #0E7490
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\fractured-prisms\1983-carnaby-street\social-preview.jpg
InstallButtonText     = &Install Album
FinishLaunchCheckbox  = &Open The Listening Room when finished
OfferLaunchOnFinish   = true

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\fractured-prisms\1983-carnaby-street\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\fractured-prisms\1983-carnaby-street\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\fractured-prisms\1983-carnaby-street\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\fractured-prisms\1983-carnaby-street\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\fractured-prisms\1983-carnaby-street\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\fractured-prisms\1983-carnaby-street\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = fractured-prisms--1983-carnaby-street
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\fractured-prisms--1983-carnaby-street
Name                  = Install Path
Value                 = [INSTALLDIR]
