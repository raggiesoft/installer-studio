; ==============================================================================
; FILE: projects/albums/the-paper-wall/2001-static-and-silence-book-1/2001-static-and-silence-book-1.rsip
; ALBUM EDITION: Static & Silence, Book 1 - The Long Road West (The Paper Wall)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User Vault)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = Static & Silence, Book 1 - The Long Road West
Tagline               = The Paper Wall - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
UpgradeCode           = {1F9C2660-C316-53F4-8318-79A841C2518E}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-2001-static-and-silence-book-1-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Music\the-paper-wall\2001-static-and-silence-book-1

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = The Paper Wall
AccentPrimaryHex      = #06B6D4
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-1\social-preview.jpg
InstallButtonText     = &Install Album
OfferLaunchOnFinish   = false

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-1\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-1\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-1\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-1\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-1\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-1\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = the-paper-wall--2001-static-and-silence-book-1
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\the-paper-wall--2001-static-and-silence-book-1
Name                  = Install Path
Value                 = [INSTALLDIR]
