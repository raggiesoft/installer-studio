; ==============================================================================
; FILE: projects/albums/the-paper-wall/2001-static-and-silence-book-2/2001-static-and-silence-book-2.rsip
; ALBUM EDITION: Static & Silence, Book 2 - The Journey Home (The Paper Wall)
; PROJECT TYPE: Host-Aware Add-On Installer (PackageKind = addon -> Listening Room)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
SchemaVersion         = 0.9
Name                  = Static & Silence, Book 2 - The Journey Home
Tagline               = The Paper Wall - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
PackageKind           = addon
UpgradeCode           = {52FA7912-0C19-5210-AB5A-FD1B68A0D3B2}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-2001-static-and-silence-book-2-$(ARCH)
OutputDir             = out
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[HostApp]
Name                  = RaggieSoft The Listening Room
UpgradeCode           = {E347B8ED-1588-5A46-A23E-441676EB4EC5}
RegistryHive          = auto
RegistryKey           = Software\RaggieSoft\The Listening Room
RegistryValue         = Install Path
FallbackSubdir        = RaggieSoft\The Listening Room
Executable            = ListeningRoom.exe
ContentTargetRoot     = LocalAppData
ContentSubdir         = RaggieSoft\Music\the-paper-wall\2001-static-and-silence-book-2
RequireHostInstalled  = true
DownloadUrl           = https://music.raggiesoft.com
LaunchUri             = https://music.raggiesoft.com
RefreshArgs           = --refresh-library

[UI]
WizardLayout          = simple
AllowChangeFolder     = false
AuthorOrArtist        = The Paper Wall
AccentPrimaryHex      = #0E7490
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-2\social-preview.jpg
InstallButtonText     = &Install Album
FinishLaunchCheckbox  = &Open The Listening Room when finished
OfferLaunchOnFinish   = true

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-2\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-2\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-2\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-2\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-2\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2001-static-and-silence-book-2\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = the-paper-wall--2001-static-and-silence-book-2
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\the-paper-wall--2001-static-and-silence-book-2
Name                  = Install Path
Value                 = [INSTALLDIR]
