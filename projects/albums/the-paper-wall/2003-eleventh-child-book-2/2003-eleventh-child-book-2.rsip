; ==============================================================================
; FILE: projects/albums/the-paper-wall/2003-eleventh-child-book-2/2003-eleventh-child-book-2.rsip
; ALBUM EDITION: The Eleventh Child, Book 2 - System.Restore (The Paper Wall)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User Vault)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = The Eleventh Child, Book 2 - System.Restore
Tagline               = The Paper Wall - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
UpgradeCode           = {ABB6BDBE-A34A-58DA-909A-B05E96699C3C}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-2003-eleventh-child-book-2-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Music\the-paper-wall\2003-eleventh-child-book-2

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = The Paper Wall
AccentPrimaryHex      = #06B6D4
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2003-eleventh-child-book-2\social-preview.jpg
InstallButtonText     = &Install Album
OfferLaunchOnFinish   = false

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\the-paper-wall\2003-eleventh-child-book-2\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2003-eleventh-child-book-2\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2003-eleventh-child-book-2\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2003-eleventh-child-book-2\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2003-eleventh-child-book-2\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-paper-wall\2003-eleventh-child-book-2\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = the-paper-wall--2003-eleventh-child-book-2
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\the-paper-wall--2003-eleventh-child-book-2
Name                  = Install Path
Value                 = [INSTALLDIR]
