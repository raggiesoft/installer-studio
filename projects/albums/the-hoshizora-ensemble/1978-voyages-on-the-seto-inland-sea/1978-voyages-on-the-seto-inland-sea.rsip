[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\the-hoshizora-ensemble--1978-voyages-on-the-seto-inland-sea
Name                  = Install Path
Value                 = [INSTALLDIR]
