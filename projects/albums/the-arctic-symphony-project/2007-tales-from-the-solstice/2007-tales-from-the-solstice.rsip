; ==============================================================================
; FILE: projects/albums/the-arctic-symphony-project/2007-tales-from-the-solstice/2007-tales-from-the-solstice.rsip
; ALBUM EDITION: Tales from the Solstice - The Arctic Symphony Project (The Arctic Symphony Project)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User Vault)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = Tales from the Solstice - The Arctic Symphony Project
Tagline               = The Arctic Symphony Project - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
UpgradeCode           = {77118205-F1D9-5811-8FDB-6B25B0D0AAE0}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-2007-tales-from-the-solstice-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Music\the-arctic-symphony-project\2007-tales-from-the-solstice

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = The Arctic Symphony Project
AccentPrimaryHex      = #06B6D4
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\2007-tales-from-the-solstice\social-preview.jpg
InstallButtonText     = &Install Album
OfferLaunchOnFinish   = false

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\the-arctic-symphony-project\2007-tales-from-the-solstice\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\2007-tales-from-the-solstice\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\2007-tales-from-the-solstice\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\2007-tales-from-the-solstice\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\2007-tales-from-the-solstice\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\2007-tales-from-the-solstice\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = the-arctic-symphony-project--2007-tales-from-the-solstice
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\the-arctic-symphony-project--2007-tales-from-the-solstice
Name                  = Install Path
Value                 = [INSTALLDIR]
