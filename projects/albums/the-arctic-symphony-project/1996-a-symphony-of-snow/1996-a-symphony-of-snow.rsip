; ==============================================================================
; FILE: projects/albums/the-arctic-symphony-project/1996-a-symphony-of-snow/1996-a-symphony-of-snow.rsip
; ALBUM EDITION: A Symphony of Snow - The Arctic Symphony Project (The Arctic Symphony Project)
; PROJECT TYPE: Host-Aware Add-On Installer (PackageKind = addon -> Listening Room)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
SchemaVersion         = 0.9
Name                  = A Symphony of Snow - The Arctic Symphony Project
Tagline               = The Arctic Symphony Project - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
PackageKind           = addon
UpgradeCode           = {295DBBD7-D334-55D9-A90F-8BE312819687}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-1996-a-symphony-of-snow-$(ARCH)
OutputDir             = out
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[HostApp]
Name                  = RaggieSoft The Listening Room
UpgradeCode           = {E347B8ED-1588-5A46-A23E-441676EB4EC5}
RegistryHive          = auto
RegistryKey           = Software\RaggieSoft\The Listening Room
RegistryValue         = Install Path
FallbackSubdir        = RaggieSoft\The Listening Room
Executable            = ListeningRoom.exe
ContentTargetRoot     = LocalAppData
ContentSubdir         = RaggieSoft\Music\the-arctic-symphony-project\1996-a-symphony-of-snow
RequireHostInstalled  = true
DownloadUrl           = https://music.raggiesoft.com
LaunchUri             = https://music.raggiesoft.com
RefreshArgs           = --refresh-library

[UI]
WizardLayout          = simple
AllowChangeFolder     = false
AuthorOrArtist        = The Arctic Symphony Project
AccentPrimaryHex      = #0E7490
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\1996-a-symphony-of-snow\social-preview.jpg
InstallButtonText     = &Install Album
FinishLaunchCheckbox  = &Open The Listening Room when finished
OfferLaunchOnFinish   = true

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\the-arctic-symphony-project\1996-a-symphony-of-snow\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\1996-a-symphony-of-snow\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\1996-a-symphony-of-snow\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\1996-a-symphony-of-snow\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\1996-a-symphony-of-snow\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-arctic-symphony-project\1996-a-symphony-of-snow\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = the-arctic-symphony-project--1996-a-symphony-of-snow
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\the-arctic-symphony-project--1996-a-symphony-of-snow
Name                  = Install Path
Value                 = [INSTALLDIR]
