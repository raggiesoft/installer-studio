; ==============================================================================
; FILE: projects/albums/the-stardust-engine/2004-progress-street/2004-progress-street.rsip
; ALBUM EDITION: Progress Street - The Stardust Engine (The Stardust Engine)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User Vault)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = Progress Street - The Stardust Engine
Tagline               = The Stardust Engine - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
UpgradeCode           = {2B1A75B8-98A6-5170-998F-413422AE4DDD}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-2004-progress-street-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Music\the-stardust-engine\2004-progress-street

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = The Stardust Engine
AccentPrimaryHex      = #06B6D4
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-stardust-engine\2004-progress-street\social-preview.jpg
InstallButtonText     = &Install Album
OfferLaunchOnFinish   = false

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\the-stardust-engine\2004-progress-street\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-stardust-engine\2004-progress-street\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-stardust-engine\2004-progress-street\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-stardust-engine\2004-progress-street\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-stardust-engine\2004-progress-street\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\the-stardust-engine\2004-progress-street\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = the-stardust-engine--2004-progress-street
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\the-stardust-engine--2004-progress-street
Name                  = Install Path
Value                 = [INSTALLDIR]
