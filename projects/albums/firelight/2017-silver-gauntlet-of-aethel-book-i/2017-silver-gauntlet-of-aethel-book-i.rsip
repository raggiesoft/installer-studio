; ==============================================================================
; FILE: projects/albums/firelight/2017-silver-gauntlet-of-aethel-book-i/2017-silver-gauntlet-of-aethel-book-i.rsip
; ALBUM EDITION: The Silver Gauntlet of Aethel, Book I - The Unwinding (Firelight)
; LAYOUT: 640x480 16:9 OpenGraph CD-Autorun Micro-Installer (Per-User Vault)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = The Silver Gauntlet of Aethel, Book I - The Unwinding
Tagline               = Firelight - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
UpgradeCode           = {079159C4-61C6-5E5B-8D12-BCE019590E2F}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-2017-silver-gauntlet-of-aethel-book-i-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Music\firelight\2017-silver-gauntlet-of-aethel-book-i

[UI]
WizardLayout          = autorun16x9
AuthorOrArtist        = Firelight
AccentPrimaryHex      = #06B6D4
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\firelight\2017-silver-gauntlet-of-aethel-book-i\social-preview.jpg
InstallButtonText     = &Install Album
OfferLaunchOnFinish   = false

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\firelight\2017-silver-gauntlet-of-aethel-book-i\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\firelight\2017-silver-gauntlet-of-aethel-book-i\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\firelight\2017-silver-gauntlet-of-aethel-book-i\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\firelight\2017-silver-gauntlet-of-aethel-book-i\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\firelight\2017-silver-gauntlet-of-aethel-book-i\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\firelight\2017-silver-gauntlet-of-aethel-book-i\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = firelight--2017-silver-gauntlet-of-aethel-book-i
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\firelight--2017-silver-gauntlet-of-aethel-book-i
Name                  = Install Path
Value                 = [INSTALLDIR]
