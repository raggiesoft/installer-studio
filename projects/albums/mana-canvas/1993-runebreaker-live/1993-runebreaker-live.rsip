; ==============================================================================
; FILE: projects/albums/mana-canvas/1993-runebreaker-live/1993-runebreaker-live.rsip
; ALBUM EDITION: Runebreaker Live - Mana Canvas (Mana Canvas)
; PROJECT TYPE: Host-Aware Add-On Installer (PackageKind = addon -> Listening Room)
; ==============================================================================

@include "..\..\..\shared\raggiesoft-defaults.rsii"

[Package]
SchemaVersion         = 0.9
Name                  = Runebreaker Live - Mana Canvas
Tagline               = Mana Canvas - Engine Room Records High-Quality Edition
WebsiteLabel          = music.raggiesoft.com
Version               = 1.0.0
Manufacturer          = Engine Room Records
PackageKind           = addon
UpgradeCode           = {DAE365A3-457E-5E95-8389-9ADF7450F074}
Architecture          = $(ARCH)
Scope                 = user
OutputName            = raggiesoft-album-1993-runebreaker-live-$(ARCH)
OutputDir             = out
HideFromInstalledApps = true
AboutUrl              = https://music.raggiesoft.com

[HostApp]
Name                  = RaggieSoft The Listening Room
UpgradeCode           = {E347B8ED-1588-5A46-A23E-441676EB4EC5}
RegistryHive          = auto
RegistryKey           = Software\RaggieSoft\The Listening Room
RegistryValue         = Install Path
FallbackSubdir        = RaggieSoft\The Listening Room
Executable            = ListeningRoom.exe
ContentTargetRoot     = LocalAppData
ContentSubdir         = RaggieSoft\Music\mana-canvas\1993-runebreaker-live
RequireHostInstalled  = true
DownloadUrl           = https://music.raggiesoft.com
LaunchUri             = https://music.raggiesoft.com
RefreshArgs           = --refresh-library

[UI]
WizardLayout          = simple
AllowChangeFolder     = false
AuthorOrArtist        = Mana Canvas
AccentPrimaryHex      = #0E7490
AccentSecondaryHex    = #EC4899
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\..\windows\RaggieSoftApps\ListeningRoom\Assets\ListeningRoom.ico
ArtworkPng            = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\mana-canvas\1993-runebreaker-live\social-preview.jpg
InstallButtonText     = &Install Album
FinishLaunchCheckbox  = &Open The Listening Room when finished
OfferLaunchOnFinish   = true

[Payload.VaultMp3]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-vaults\engine-room-records\artists\mana-canvas\1993-runebreaker-live\vault\mp3
TargetSubdir          = hq-mp3

[Payload.TracksJson]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\mana-canvas\1993-runebreaker-live\tracks.json

[Payload.AlbumArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\mana-canvas\1993-runebreaker-live\album-art.jpg

[Payload.SocialArt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\mana-canvas\1993-runebreaker-live\social-preview.jpg

[Payload.LyricsVtt]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\mana-canvas\1993-runebreaker-live\lyrics
TargetSubdir          = lyrics

[Payload.SunoPrompts]
Source                = ..\..\..\..\..\..\raggiesoft-servers\raggiesoft-assets\engine-room-records\artists\mana-canvas\1993-runebreaker-live\suno-prompts
TargetSubdir          = suno-prompts

[Registry.AlbumList]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\List
Name                  = mana-canvas--1993-runebreaker-live
Value                 = [INSTALLDIR]

[Registry.AlbumDetail]
Root                  = HKCU
Key                   = Software\RaggieSoft\The Listening Room\Albums\mana-canvas--1993-runebreaker-live
Name                  = Install Path
Value                 = [INSTALLDIR]
