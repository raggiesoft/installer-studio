; ==============================================================================
; FILE: projects/apps/help-studio/help-studio.rsip
; APPLICATION: RaggieSoft Help Studio (v0.5.0)
; COMPILER: RaggieSoft Installer Studio v0.6.0 (Zero-Prerequisite C++20 /MT!)
; ==============================================================================
; PLAIN-ENGLISH OVERVIEW FOR 100-LEVEL READERS:
;   Packages RaggieSoft Help Studio (`HelpStudio.exe` 8-View Win32 C++20 Visual
;   IDE, `rshbuild.exe` Headless CLI & Legacy `.CHM`/`.HLP` Decompiler,
;   `RaggieSoftHelp.exe` Universal Offline `F1` & Rescue Viewer, C++/C#/VB6/TS
;   `F1` SDK Headers, Dogfooded `raggiesoft.help-studio` Manual, and Classic
;   StoreTrainer `.HLP`+`.CNT` Sample) as native Windows 11 `x64` & `ARM64`
;   `.msi` and Universal `Setup.exe` installers—with ZERO `.NET` or `WebView2`
;   runtime prerequisites!
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
SchemaVersion            = 0.8
Name                     = RaggieSoft Help Studio
Tagline                  = Native C++20 F1 Context Help IDE & Legacy .CHM / WinHelp .HLP Importer
WebsiteLabel             = raggiesoftstudio.com/help-studio
Version                  = 0.6.1
Manufacturer             = RaggieSoft
UpgradeCode              = {6E39D214-8B72-4F5A-9C3E-147253485050}
Architecture             = $(ARCH)
Scope                    = machine
RequestedExecutionLevel  = asInvoker
OutputName               = raggiesoft-help-studio-v$(VERSION)-$(ARCH)
UniversalOutputName      = raggiesoft-help-studio-v$(VERSION)
BuildUniversal           = true
UniversalDownloadBaseUrl = https://assets.raggiesoft.com/desktop-apps/windows/apps/help-studio/releases/v$(VERSION)
OutputDir                = out
BuildBootstrapper        = true
AboutUrl                 = https://raggiesoftstudio.com/help-studio

[Upgrade]
Strategy                 = major
Schedule                 = early
MigrateFeatures          = true
UpdateFeedUrl            = https://assets.raggiesoft.com/desktop-apps/windows/studio-apps-manifest.json

[Install]
DefaultSubdir            = RaggieSoft\RaggieSoft Studio\Help Studio
StartMenuFolder          = RaggieSoft Help Studio
MainExecutable           = StudioIDE\HelpStudio.exe

[UI]
WizardLayout             = aerowizard
MsiDialogPreset          = express_custom
AccentPrimaryHex         = #107C74
AccentSecondaryHex       = #D97706
LicenseRtf               = License.rtf
IconFile                 = ..\..\..\..\help-studio\assets\HelpStudio.ico
InstallButtonText        = &Install
FinishLaunchCheckbox     = &Open RaggieSoft Help Studio when setup finishes

[SetupType.Workstation]
Title                    = &Workstation F1 Help IDE + CLI + SDKs (Recommended)
Description              = Installs the 8-view C++20 HelpStudio.exe IDE, rshbuild.exe CLI & CHM/HLP decompiler, RaggieSoftHelp.exe viewer, and F1 SDKs.
Tier                     = typical
Glyph                    = Bolt
Recommended              = true

[SetupType.HeadlessCli]
Title                    = &Headless CI/CD Compiler & CHM/HLP Decompiler Only (Compact)
Description              = Installs only the zero-dependency rshbuild.exe CLI compiler, validator, and legacy importer for build servers.
Tier                     = minimal
Glyph                    = Cube
Recommended              = false

[SetupType.CompleteSuite]
Title                    = Com&plete Suite + Classic WinHelp .HLP/.CNT Samples
Description              = Installs the full Workstation IDE, CLI, SDKs, offline F1 manual, and classic .HLP/.CNT + .RSHP sample projects.
Tier                     = complete
Glyph                    = Blocks
Recommended              = false

[SetupType.Custom]
Title                    = C&ustom Component Selection
Description              = Choose individual IDE, CLI, F1 SDK headers, offline documentation, and sample project features.
Tier                     = custom
Glyph                    = Sliders
Recommended              = false

[Feature.Main]
Title                    = Headless Compiler & Legacy .CHM / .HLP Decompiler CLI (rshbuild)
Description              = Zero-dependency static C++20 .rshp compiler, WCAG 2.2 AA gate, Auto-VPAT 2.5 generator, and raw .CHM / .HLP importer.
Inclusion                = minimal
DisallowAbsent           = true

[Feature.StudioIde]
Title                    = HelpStudio.exe Visual Authoring IDE & F1 SDK Headers
Description              = 8-view tree-first Win32 C++20 IDE with live Msftedit.dll F1 preview and C++/C#/VB6/TypeScript SDK headers.
Inclusion                = typical

[Feature.HelpDocs]
Parent                   = StudioIde
Title                    = Offline F1 Authoring Manual & Universal Help Viewer
Description              = Dogfooded raggiesoft.help-studio offline manual and universal RaggieSoftHelp.exe viewer.
Inclusion                = typical

[Feature.Samples]
Title                    = Sample .RSHP & Classic WinHelp (.HLP + .CNT) Rescue Fixtures
Description              = Ready-to-open StoreTrainer Classic 1998 .hlp/.cnt rescue sample and Help Studio Markdown source project.
Inclusion                = complete

[Payload.CliCompiler]
Source                   = ..\..\..\..\help-studio\build\INSTALLDIR\Release\$(ARCH)\CLI
TargetSubdir             = CLI
Feature                  = Main

[Payload.StudioIde]
Source                   = ..\..\..\..\help-studio\build\INSTALLDIR\Release\$(ARCH)\StudioIDE
TargetSubdir             = StudioIDE
Feature                  = StudioIde

[Payload.SdkHeaders]
Source                   = ..\..\..\..\help-studio\build\INSTALLDIR\Release\$(ARCH)\SDK
TargetSubdir             = SDK
Feature                  = StudioIde

[Payload.HelpViewer]
Source                   = ..\..\..\..\help-studio\build\INSTALLDIR\Release\$(ARCH)\HelpViewer
TargetSubdir             = HelpViewer
Feature                  = HelpDocs

[Payload.HelpManual]
Source                   = ..\..\..\..\help-studio\build\INSTALLDIR\Release\$(ARCH)\HelpModules\raggiesoft.help-studio
TargetSubdir             = HelpModules\raggiesoft.help-studio
Feature                  = HelpDocs

[Payload.Samples]
Source                   = ..\..\..\..\help-studio\build\INSTALLDIR\Release\$(ARCH)\Samples
TargetSubdir             = Samples
Feature                  = Samples

[FileAssociation.RshpProject]
Extension                = .rshp
ProgId                   = RaggieSoft.HelpStudio.Project
Description              = RaggieSoft Help Studio Authoring Project
TargetFile               = StudioIDE\HelpStudio.exe
ContentType              = application/x-raggiesoft-rshp
PerceivedType            = text
Verbs                    = open:&Open in Help Studio:"%1"
Advertise                = false
Feature                  = StudioIde

[Shortcut.StudioStart]
Name                     = RaggieSoft Help Studio
TargetFile               = StudioIDE\HelpStudio.exe
Location                 = StartMenu
Feature                  = StudioIde

[Shortcut.HelpStart]
Name                     = RaggieSoft Help Viewer (.RSHM, .CHM & .HLP)
TargetFile               = HelpViewer\RaggieSoftHelp.exe
Arguments                = "--module raggiesoft.help-studio"
Location                 = StartMenu
Feature                  = HelpDocs

[Registry.InstallPath]
Root                     = HKLM
Key                      = Software\RaggieSoft\Help Studio
Name                     = Install Path
Value                    = [INSTALLDIR]
Feature                  = Main

[Registry.HelpModulePath]
Root                     = HKLM
Key                      = Software\RaggieSoft\HelpModules
Name                     = raggiesoft.help-studio
Value                    = [INSTALLDIR]HelpModules\raggiesoft.help-studio
Feature                  = HelpDocs
