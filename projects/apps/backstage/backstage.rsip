; ==============================================================================
; FILE: projects/apps/backstage/backstage.rsip
; APPLICATION: RaggieSoft Backstage (v1.0.0)
; COMPILER: RaggieSoft Installer Studio (instbuild.exe -> .msi + Setup.exe)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = RaggieSoft Backstage
Tagline               = Behind-the-Scenes Stories & Creative Companion
WebsiteLabel          = backstage.raggiesoft.com
Version               = 1.0.0
Manufacturer          = RaggieSoft
UpgradeCode           = {B6A77C49-DDFA-5E12-99A8-D2CC267C124F}
Architecture          = $(ARCH)
Scope                 = machine
OutputName            = raggiesoft-backstage-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
AboutUrl              = https://backstage.raggiesoft.com

[Install]
DefaultSubdir         = RaggieSoft\Backstage
StartMenuFolder       = RaggieSoft Backstage
MainExecutable        = Backstage.exe

[UI]
WizardLayout          = standard
AccentPrimaryHex      = #E11D48
AccentSecondaryHex    = #F59E0B
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\Backstage\Assets\Backstage.ico
InstallButtonText     = &Install
FinishLaunchCheckbox  = &Open RaggieSoft Backstage when setup finishes

[Payload.App]
Source                = ..\..\..\..\windows\RaggieSoftApps\Backstage\bin\Release\net10.0-windows\win-$(ARCH)\publish
Feature               = Main

[Payload.OfflineSeed]
Source                = ..\..\..\offline-seeds\backstage
TargetSubdir          = OfflineSeed
Feature               = Main

[Shortcut.StartLink]
Name                  = RaggieSoft Backstage
TargetFile            = Backstage.exe
Location              = StartMenu

[Shortcut.DesktopLink]
Name                  = RaggieSoft Backstage
TargetFile            = Backstage.exe
Location              = Desktop

[Registry.InstallPath]
Root                  = HKLM
Key                   = Software\RaggieSoft\Backstage
Name                  = Install Path
Value                 = [INSTALLDIR]
