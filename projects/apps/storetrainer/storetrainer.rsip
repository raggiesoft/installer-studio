; ==============================================================================
; FILE: projects/apps/storetrainer/storetrainer.rsip
; APPLICATION: RaggieSoft StoreTrainer (v2.0.0)
; COMPILER: RaggieSoft Installer Studio v0.5.0 (ACME #008080 FullScreenTeal!)
; ==============================================================================
; PLAIN-ENGLISH OVERVIEW FOR 100-LEVEL READERS:
;   Honors StoreTrainer's 1998-2000 classic PC-gaming heritage with our
;   `fullscreenteal` (`#008080` Microsoft ACME Setup Engine) backdrop, floating
;   3D `#C0C0C0` dialog, classic Typical / Compact / Complete / Custom Setup
;   Types, and rotating PC-gaming billboard cards—while automatically switching
;   to semantic OS system colors whenever a Contrast Theme is enabled!
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                     = RaggieSoft StoreTrainer
Tagline                  = PC Game & Companion Trainer Organizer
WebsiteLabel             = storetrainer.raggiesoft.com
Version                  = 2.0.0
Manufacturer             = RaggieSoft
UpgradeCode              = {E20427FF-5DC2-569E-A13A-D7237BE67EA2}
Architecture             = $(ARCH)
Scope                    = machine
OutputName               = raggiesoft-storetrainer-$(ARCH)
UniversalOutputName      = raggiesoft-storetrainer
BuildUniversal           = true
UniversalDownloadBaseUrl = https://assets.raggiesoft.com/desktop-apps/windows/apps/storetrainer
OutputDir                = out
BuildBootstrapper        = true
AboutUrl                 = https://storetrainer.raggiesoft.com

[Install]
DefaultSubdir            = RaggieSoft\StoreTrainer
StartMenuFolder          = RaggieSoft StoreTrainer
MainExecutable           = StoreTrainer.exe

[UI]
WizardLayout             = fullscreenteal
SetupTypePreset          = win95_classic
MsiDialogPreset          = express_custom
AccentPrimaryHex         = #117A72
AccentSecondaryHex       = #F59E0B
LicenseRtf               = License.rtf
IconFile                 = ..\..\..\..\windows\RaggieSoftApps\StoreTrainer\Assets\StoreTrainer.ico
InstallButtonText        = &Install
FinishLaunchCheckbox     = &Open RaggieSoft StoreTrainer when setup finishes

[Prerequisite.DotNet10]
Preset                   = DotNet10Desktop
Distribution             = download

[Feature.Main]
Title                    = StoreTrainer Game & Trainer Organizer
Description              = Pair classic and modern PC games with companion trainers, save-game backups, and floating cheat cards.
Inclusion                = minimal
DisallowAbsent           = true

[Billboard.Trainers]
Headline                 = One-Click Game & Trainer Pairing
Body                     = Launch any PC game alongside its companion trainer—or play unassisted anytime with a single click.
Glyph                    = Play

[Billboard.Backups]
Headline                 = Automatic Save-Game Protection
Body                     = Back up your saved games before experimenting with trainers and view classic ASCII info files cleanly.
Glyph                    = ShieldCheck

[Billboard.ClassicImport]
Headline                 = Imports Classic StoreTrainer 1.0 & 1.1 Profiles
Body                     = Bring over classic My StoreFiles profiles seamlessly with the built-in StoreFile Upgrade Wizard.
Glyph                    = Sparkle

[Payload.App]
Source                   = ..\..\..\..\windows\RaggieSoftApps\StoreTrainer\bin\Release\net10.0-windows\win-$(ARCH)\publish
Feature                  = Main

[FileAssociation.StfxProfile]
Extension                = .stfx
ProgId                   = RaggieSoft.StoreTrainer.Profile
Description              = RaggieSoft StoreTrainer Game Profile
TargetFile               = StoreTrainer.exe
ContentType              = application/x-raggiesoft-storetrainer
PerceivedType            = document
Verbs                    = open:&Open in StoreTrainer:"%1"
Advertise                = false
Feature                  = Main

[Shortcut.StartLink]
Name                     = RaggieSoft StoreTrainer
TargetFile               = StoreTrainer.exe
Location                 = StartMenu
Feature                  = Main

[Shortcut.DesktopLink]
Name                     = RaggieSoft StoreTrainer
TargetFile               = StoreTrainer.exe
Location                 = Desktop
Feature                  = Main

[Registry.InstallPath]
Root                     = HKLM
Key                      = Software\RaggieSoft\StoreTrainer
Name                     = Install Path
Value                    = [INSTALLDIR]
Feature                  = Main
