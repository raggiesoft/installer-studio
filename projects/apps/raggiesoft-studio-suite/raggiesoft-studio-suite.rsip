; ==============================================================================
; PLAIN-ENGLISH OVERVIEW FOR 100-LEVEL READERS:
;   What is this file?
;     This `.rsip` manifest compiles the official **RaggieSoft Studio Unified
;     Workload Suite (`v0.9.0`)**—a lightweight (<2 MB) Visual Studio Installer-
;     style Workload Chainer that lets developers, technical writers, and
;     compliance engineers pick any combination of our 7 shipped Windows 11
;     (`x64` & `ARM64`) RaggieSoft Studio tools in one checklist:
;       1. RaggieSoft Installer Studio (`v0.9.0`)
;       2. RaggieSoft Accessibility Studio (`v1.0.1`)
;       3. RaggieSoft Help Studio (`v0.7.0`)
;       4. RaggieSoft Training Studio (`v0.7.0`)
;       5. RaggieSoft Showcase Studio (`v0.5.1`)
;       6. RaggieSoft MSI Prism (`v0.9.0` Standalone SQL Editor)
;       7. RaggieSoft Self-Extractor (`v0.9.0` Standalone LZMS Builder)
;
;   How does `Delivery = web` work under the hood?
;     - Instead of forcing users to download a 45+ MB bundle containing tools
;       they did not check, `SetupWizard.exe` streams ONLY the user's selected
;       `.msi` packages over TLS 1.2/1.3 (`WinHTTP`) from their immutable
;       `releases/v<X.Y.Z>/` CDN folders.
;     - Before launching `MsiInstallProductW`, `SetupWizard.exe` verifies each
;       downloaded `.msi` byte-for-byte against the compile-time `Sha256X64` /
;       `Sha256Arm64` digest via stock Windows `System32\bcrypt.dll`.
;     - Every selected tool installs under ONE single UAC elevation, tracks
;       strictly monotonic Dual-Bar progress (`Overall Suite Progress` +
;       `Current Component`), dynamically adopts any already-installed
;       standalone sibling (`RS_SUITE_MANAGED=1`), and unwinds newly installed
;       session packages in LIFO order (`SuiteRollbackPolicy = rollback_new`)
;       if cancelled!
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

; `[Package]` configures our Suite Chainer (`PackageKind = suite`), Universal
; `x64 + ARM64` packaging (`BuildUniversal = true`), and transactional LIFO
; session rollback (`SuiteRollbackPolicy = rollback_new`).
[Package]
SchemaVersion            = 0.9
Name                     = RaggieSoft Studio Suite
Tagline                  = Unified Workload Installer — Pick Any RaggieSoft Studio IDEs & Compilers
WebsiteLabel             = raggiesoftstudio.com
Version                  = 0.9.0
Manufacturer             = RaggieSoft
PackageKind              = suite
SuiteRollbackPolicy      = rollback_new
UpgradeCode              = {91C4A7E2-5D38-4B90-A612-524147535455}
Architecture             = $(ARCH)
Scope                    = machine
RequestedExecutionLevel  = asInvoker
OutputName               = raggiesoft-studio-suite-v$(VERSION)-$(ARCH)
UniversalOutputName      = raggiesoft-studio-suite-v$(VERSION)
BuildUniversal           = true
UniversalDownloadBaseUrl = https://assets.raggiesoft.com/desktop-apps/windows/apps/raggiesoft-studio-suite/releases/v$(VERSION)
OutputDir                = out
AboutUrl                 = https://raggiesoftstudio.com

; `[Upgrade]` wires the shared static-CDN update feed (`studio-apps-manifest.json`)
; consumed by both `RsUpdate.exe` and RaggieSoft Launcher.
[Upgrade]
Strategy                 = major
UpdateFeedUrl            = https://assets.raggiesoft.com/desktop-apps/windows/studio-apps-manifest.json

; `[Install]` sets the default Suite parent root and Start Menu folder.
[Install]
DefaultSubdir            = RaggieSoft\RaggieSoft Studio
StartMenuFolder          = RaggieSoft Studio

; `[UI]` configures Royal Cobalt (`#2563EB`) and Amber (`#FBBF24`) branding that
; passes WCAG 2.2 Level AA contrast in both Light Mode and Dark Mode.
[UI]
WizardLayout             = aerowizard
AccentPrimaryHex         = #2563EB
AccentSecondaryHex       = #FBBF24
IconFile                 = ..\..\..\..\windows\RaggieSoftApps\RaggieSoftLauncher\Assets\RaggieSoftLauncher.ico
InstallButtonText        = &Install Selected

; ==============================================================================
; 7 SELECTABLE STUDIO WORKLOADS (`Delivery = web` + `bcrypt.dll` SHA-256 Gate)
; ==============================================================================

; Workload 1: RaggieSoft Installer Studio v0.9.0 (Flagship Packaging IDE & CLI)
[SuitePackage.InstallerStudio]
