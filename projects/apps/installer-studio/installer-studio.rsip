; ==============================================================================
; FILE: projects/apps/installer-studio/installer-studio.rsip
; APPLICATION: RaggieSoft Installer Studio (v0.2.1 Technical Preview)
; COMPILER: RaggieSoft Installer Studio (instbuild.exe -> .msi + Setup.exe)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                  = RaggieSoft Installer Studio
Tagline               = Install Without Limits - AeroWizard IDE, MSI Compiler & Prism
WebsiteLabel          = raggiesoftstudio.com
Version               = 0.2.1
Manufacturer          = RaggieSoft
UpgradeCode           = {D9C0EF36-990C-519C-A9C7-D7E19FDD5627}
Architecture          = $(ARCH)
Scope                 = machine
OutputName            = raggiesoft-installer-studio-$(ARCH)
OutputDir             = out
BuildBootstrapper     = true
AboutUrl              = https://raggiesoftstudio.com

[Install]
DefaultSubdir         = RaggieSoft\Installer Studio
StartMenuFolder       = RaggieSoft Installer Studio
MainExecutable        = InstallerStudio.exe

[UI]
WizardLayout          = aerowizard
MsiDialogPreset       = express_custom
AccentPrimaryHex      = #2563EB
AccentSecondaryHex    = #FBBF24
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\RaggieSoftLauncher\Assets\RaggieSoftLauncher.ico
InstallButtonText     = &Install
FinishLaunchCheckbox  = &Open RaggieSoft Installer Studio when setup finishes

[Feature.Main]
Title                 = Visual IDE, CLI Compiler & MSI Prism
Description           = Core 64-bit native Win32 C++20 executables (InstallerStudio.exe, instbuild.exe, SetupWizard.exe, msiprism.exe).
Level                 = 1

[Feature.Templates]
Title                 = Dialog Presets & AI Agent Specifications
Description           = Reusable .rsii dialog workflow includes plus llms.txt and SKILL.md documentation.
Level                 = 1

[Payload.CoreBinaries]
Source                = ..\..\..\bin\$(ARCH)
TargetRoot            = INSTALLDIR
Feature               = Main

[Payload.AiSpecs]
Source                = ..\..\..\specs
TargetRoot            = INSTALLDIR
TargetSubdir          = specs
Feature               = Templates

[Payload.DialogTemplates]
Source                = ..\..\..\templates
TargetRoot            = INSTALLDIR
TargetSubdir          = templates
Feature               = Templates

[FileAssociation.RsipProject]
Extension             = .rsip
ProgId                = RaggieSoft.InstallerStudio.Project
Description           = RaggieSoft Installer Project
TargetFile            = InstallerStudio.exe
ContentType           = text/x-raggiesoft-rsip
PerceivedType         = text
Verbs                 = open:&Open in Installer Studio:"%1"
Advertise             = false
Feature               = Main

[FileAssociation.RsisSuite]
Extension             = .rsis
ProgId                = RaggieSoft.InstallerStudio.Suite
Description           = RaggieSoft Installer Suite
TargetFile            = InstallerStudio.exe
ContentType           = text/x-raggiesoft-rsis
PerceivedType         = text
Verbs                 = open:&Open Suite in Installer Studio:"%1"
Advertise             = false
Feature               = Main

[Shortcut.StudioIde]
Name                  = RaggieSoft Installer Studio
TargetFile            = InstallerStudio.exe
Location              = StartMenu

[Shortcut.MsiPrism]
Name                  = RaggieSoft MSI Prism
TargetFile            = msiprism.exe
Location              = StartMenu

[Shortcut.StudioDesktop]
Name                  = RaggieSoft Installer Studio
TargetFile            = InstallerStudio.exe
Location              = Desktop

[Registry.InstallPath]
Root                  = HKLM
Key                   = Software\RaggieSoft\Installer Studio
Name                  = Install Path
Value                 = [INSTALLDIR]
