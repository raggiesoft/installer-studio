; ==============================================================================
; FILE: projects/apps/installer-studio/installer-studio.rsip
; APPLICATION: RaggieSoft Installer Studio (v0.5.0 Technical Preview)
; COMPILER: RaggieSoft Installer Studio (instbuild.exe -> .msi + Universal Setup.exe)
; ==============================================================================

@include "..\..\shared\raggiesoft-defaults.rsii"

[Package]
Name                     = RaggieSoft Installer Studio
Tagline                  = Install Without Limits - Tree-First AeroWizard IDE, MSI Compiler, Prism & Help
WebsiteLabel             = raggiesoftstudio.com
Version                  = 0.5.0
Manufacturer             = RaggieSoft
UpgradeCode              = {D9C0EF36-990C-519C-A9C7-D7E19FDD5627}
Architecture             = $(ARCH)
Scope                    = machine
OutputName               = raggiesoft-installer-studio-$(ARCH)
UniversalOutputName      = raggiesoft-installer-studio
BuildUniversal           = true
UniversalDownloadBaseUrl = https://assets.raggiesoft.com/desktop-apps/windows/apps/installer-studio
OutputDir                = out
BuildBootstrapper        = true
AboutUrl                 = https://raggiesoftstudio.com

[Install]
DefaultSubdir         = RaggieSoft\Installer Studio
StartMenuFolder       = RaggieSoft Installer Studio
MainExecutable        = InstallerStudio.exe

[UI]
WizardLayout          = aerowizard
MsiDialogPreset       = express_custom
AccentPrimaryHex      = #2563EB
AccentSecondaryHex    = #FBBF24
LicenseRtf            = License.rtf
IconFile              = ..\..\..\..\windows\RaggieSoftApps\RaggieSoftLauncher\Assets\RaggieSoftLauncher.ico
InstallButtonText     = &Install
FinishLaunchCheckbox  = &Open RaggieSoft Installer Studio when setup finishes

; Hierarchical MSI SelectionTree Features with plain-English `Inclusion` tiers (`minimal` vs `typical`)!
[Feature.Main]
Title                 = Visual IDE, CLI Compiler, MSI Prism & Help Viewer
Description           = Core 64-bit native Win32 C++20 executables (InstallerStudio.exe, instbuild.exe, SetupWizard.exe, msiprism.exe, RaggieSoftHelp.exe).
Inclusion             = minimal
DisallowAbsent        = true

[Feature.HelpDocs]
Parent                = Main
Title                 = Offline Documentation Module (.rshm.json)
Description           = Searchable offline HTML5 help topics for F1 context navigation inside RaggieSoftHelp.exe.
Inclusion             = typical

[Feature.Templates]
Title                 = Reusable Dialog & Workflow Presets
Description           = Reusable .rsii @include dialog presets and starter .rsip blueprints.
Inclusion             = typical

[Feature.AiSpecs]
Parent                = Templates
Title                 = AI Agent Grammar & SKILL.md Specs
Description           = Machine-readable llms.txt, llms-full.txt, and SKILL.md documentation for autonomous AI packaging.
Inclusion             = typical

[Payload.HelpManifest]
Source                = ..\..\..\help\raggiesoft.installer-studio\module.rshm.json
TargetRoot            = INSTALLDIR
TargetSubdir          = HelpModules\raggiesoft.installer-studio
Feature               = HelpDocs

[Payload.HelpTopics]
Source                = ..\..\..\help\raggiesoft.installer-studio\topics
TargetRoot            = INSTALLDIR
TargetSubdir          = HelpModules\raggiesoft.installer-studio\topics
Feature               = HelpDocs

[Payload.CoreBinaries]
Source                = ..\..\..\bin\$(ARCH)
TargetRoot            = INSTALLDIR
Feature               = Main

[Payload.DialogTemplates]
Source                = ..\..\..\templates
TargetRoot            = INSTALLDIR
TargetSubdir          = templates
Feature               = Templates

[Payload.AiSpecs]
Source                = ..\..\..\specs
TargetRoot            = INSTALLDIR
TargetSubdir          = specs
Feature               = AiSpecs

[FileAssociation.RsipProject]
Extension             = .rsip
ProgId                = RaggieSoft.InstallerStudio.Project
Description           = RaggieSoft Installer Project
TargetFile            = InstallerStudio.exe
ContentType           = text/x-raggiesoft-rsip
PerceivedType         = text
Verbs                 = open:&Open in Installer Studio:"%1"
Advertise             = false
Feature               = Main

[FileAssociation.RsisSuite]
Extension             = .rsis
ProgId                = RaggieSoft.InstallerStudio.Suite
Description           = RaggieSoft Installer Suite
TargetFile            = InstallerStudio.exe
ContentType           = text/x-raggiesoft-rsis
PerceivedType         = text
Verbs                 = open:&Open Suite in Installer Studio:"%1"
Advertise             = false
Feature               = Main

[Shortcut.StudioIde]
Name                  = RaggieSoft Installer Studio
TargetFile            = InstallerStudio.exe
Location              = StartMenu

[Shortcut.MsiPrism]
Name                  = RaggieSoft MSI Prism
TargetFile            = msiprism.exe
Location              = StartMenu

[Shortcut.HelpViewer]
Name                  = RaggieSoft Help Viewer
TargetFile            = RaggieSoftHelp.exe
Location              = StartMenu

[Shortcut.StudioDesktop]
Name                  = RaggieSoft Installer Studio
TargetFile            = InstallerStudio.exe
Location              = Desktop

[Registry.InstallPath]
Root                  = HKLM
Key                   = Software\RaggieSoft\Installer Studio
Name                  = Install Path
Value                 = [INSTALLDIR]

[Registry.HelpModulePath]
Root                  = HKLM
Key                   = Software\RaggieSoft\HelpModules
Name                  = raggiesoft.installer-studio
Value                 = [INSTALLDIR]HelpModules\raggiesoft.installer-studio
